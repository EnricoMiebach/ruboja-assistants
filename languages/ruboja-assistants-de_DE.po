msgstr "Es ist kein Ruboja-API-Schlüssel hinterlegt."

#. translators: %d: HTTP status code.
#: includes/class-api-client.php:165
#, php-format
msgid "Ruboja answered with HTTP status %d."
msgstr "Ruboja hat mit HTTP-Status %d geantwortet."

#: includes/class-embed.php:169
msgid "Ruboja assistant: this assistant is not released or no longer available. Check Settings → Ruboja Assistants."
msgstr "Ruboja-Assistent: Dieser Assistent ist nicht freigegeben oder nicht mehr verfügbar. Bitte unter Einstellungen → Ruboja-Assistenten prüfen."

#: includes/class-embed.php:244
msgid "Close assistant"
msgstr "Assistent schließen"

#: includes/class-embed.php:271
msgid "Start assistant"
msgstr "Assistent starten"

#: includes/class-embed.php:272
msgid "Please enable JavaScript to use the assistant."
msgstr "Bitte aktivieren Sie JavaScript, um den Assistenten zu nutzen."

#: includes/class-embed.php:295
msgid "Starting the assistant …"
msgstr "Assistent wird gestartet …"

#: includes/class-embed.php:296
#: includes/class-rest-controller.php:137
msgid "The assistant could not be started. Please try again later."
msgstr "Der Assistent konnte nicht gestartet werden. Bitte versuchen Sie es später noch einmal."

#: includes/class-embed.php:297
msgid "Try again"
msgstr "Erneut versuchen"

#: includes/class-rest-controller.php:85
msgid "This assistant is not available."
msgstr "Dieser Assistent ist nicht verfügbar."

#: includes/class-rest-controller.php:89
msgid "Please log in to use this assistant."
msgstr "Bitte melden Sie sich an, um diesen Assistenten zu nutzen."

#: includes/class-rest-controller.php:93
msgid "Too many requests. Please try again later."
msgstr "Zu viele Anfragen. Bitte versuchen Sie es später noch einmal."

#: includes/class-settings.php:301
msgid "This assistant is provided by Ruboja. When you start it, your input and any files you upload are transmitted to Ruboja and processed by an AI model. Please do not enter information you do not want to share."
msgstr "Dieser Assistent wird über Ruboja bereitgestellt. Wenn Sie ihn starten, werden Ihre Eingaben und hochgeladenen Dateien an Ruboja übertragen und von einem KI-Modell verarbeitet. Bitte geben Sie nichts ein, was Sie nicht teilen möchten."

