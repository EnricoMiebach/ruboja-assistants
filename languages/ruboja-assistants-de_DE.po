#: includes/class-admin-page.php:475
#, php-format
msgid "Connected. %d assistant is accessible with this API key."
msgid_plural "Connected. %d assistants are accessible with this API key."
msgstr[0] "Verbunden. Mit diesem API-Schlüssel ist %d Assistent zugänglich."
msgstr[1] "Verbunden. Mit diesem API-Schlüssel sind %d Assistenten zugänglich."

#: includes/class-admin-page.php:489
msgid "You are not allowed to change these settings."
msgstr "Sie dürfen diese Einstellungen nicht ändern."

#: includes/class-api-client.php:68
#: includes/class-api-client.php:108
#: includes/class-api-client.php:176
msgid "Ruboja returned an unexpected response."
msgstr "Ruboja hat unerwartet geantwortet."

#: includes/class-api-client.php:128
